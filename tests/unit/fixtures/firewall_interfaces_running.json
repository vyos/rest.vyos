{
  "ipv4": {
    "input": {
      "filter": {
        "default-action": "accept",
        "rule": {
          "10": { "action": "accept", "state": "established" },
          "20": {
            "action": "drop",
            "state": "invalid",
            "source": { "address": "10.0.0.0/8" },
            "destination": { "port": "22" }
          }
        }
      }
    },
    "forward": {
      "filter": {
        "default-action": "accept"
      }
    },
    "output": {
      "filter": {
        "default-action": "accept"
      }
    },
    "name": {
      "my-ruleset": {
        "rule": {
          "1": { "action": "accept" }
        }
      }
    }
  },
  "ipv6": {
    "input": {
      "filter": {
        "default-action": "accept"
      }
    }
  }
}
